{
  "name": "PSRestfulProduct",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "PSRestful product extraId"
    },
    "product_name": {
      "type": "string",
      "description": "Product name"
    },
    "supplier_code": {
      "type": "string",
      "description": "Supplier code"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "primary_image_url": {
      "type": "string",
      "description": "Primary product image URL"
    },
    "media_urls": {
      "type": "array",
      "description": "All media image URLs with view labels",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "view": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "product_id",
    "product_name",
    "supplier_code"
  ]
}