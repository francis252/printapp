{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "Reference to the originating quote"
    },
    "title": {
      "type": "string",
      "description": "Work order title"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "description": "Copy of quote line items including mockups"
    },
    "notes": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "waiting_stock",
        "stock_received",
        "in_production",
        "finished"
      ],
      "default": "waiting_stock",
      "description": "Current production stage"
    },
    "total": {
      "type": "number"
    }
  },
  "required": [
    "quote_id",
    "title",
    "customer_name"
  ]
}